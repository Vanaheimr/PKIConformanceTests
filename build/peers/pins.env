# The peers taken from upstream rather than from Debian 13, each pinned to a
# version and the SHA-256 its project published for it. Read by
# setup-wsl.sh and by the nightly's upstream lane; a pin is advanced by
# changing both lines together.

# lego - Debian 13 ships 4.9.1 (2022), without ARI or profiles; the suite
# needs the current major version. Hash from lego_5.7.0_checksums.txt of
# https://github.com/go-acme/lego/releases/tag/v5.7.0
LEGO_VERSION=5.7.0
LEGO_SHA256=ffc7f0d75810a70affffb10fc20a8db4d6dd4917f8f88cda9b54fb08c82a1967

# step-ca - not in Debian 13. A second ACME server of other hands for
# Hermod's client (phase 5). Hash from checksums.txt of
# https://github.com/smallstep/certificates/releases/tag/v0.30.2
STEPCA_VERSION=0.30.2
STEPCA_SHA256=1726ee7b6a24c67abb8c9e96ad671623b29b3d34f6a712f7087495f31331e54b

# Pebble upstream - Debian 13 ships 2.6.0 (2024), with ARI of draft 03 and
# without profiles; both are tested, the upstream one beside Debian's under
# /usr/local/lib/pkiconformance. Hashes of the release assets of
# https://github.com/letsencrypt/pebble/releases/tag/v2.10.3
PEBBLE_VERSION=2.10.3
PEBBLE_SHA256=7e33cf3e426b67e9e647c44e8cc91683caa8ab331f7a99e5e27fcee291c4c7e2
PEBBLE_CHALLTESTSRV_SHA256=00b2c5ef525cd8ad56cda898a7cac6169a10b0fd3f2a7456fe0cec92e7b36cb6

# Boulder - Let's Encrypt's own server, as its Docker compose stack, at a
# release tag and the commit it names; the images of its tools, of Vitess
# and of Sunlight as its CI at that tag pulls them
# (.github/workflows/boulder-ci.yml).
BOULDER_VERSION=v0.20261117.0
BOULDER_COMMIT=7a93d5945d88c7e24e5da998a7194233c3d783cd
BOULDER_TOOLS_TAG=go1.27.4_2026-11-10
BOULDER_VTCOMBOSERVER_TAG=vitessv24.0.3_2026-10-30
BOULDER_SUNLIGHT_TAG=sunlightv0.10.2_2026-10-29

# certbot upstream - Debian 13 ships 4.0.0, without ARI (4.1.0) and IP
# identifiers (5.0); both are tested, the upstream one in a venv beside
# Debian's under /usr/local/lib/pkiconformance. Its packages and their
# hashes are in certbot-requirements.txt, advanced together with this.
CERTBOT_VERSION=5.10.0

# acme.sh upstream - Debian 13 ships 3.1.1, without ARI and profiles; both
# are tested, the upstream one as a clone at the release tag and the commit
# it names, beside Debian's. https://github.com/acmesh-official/acme.sh
ACMESH_VERSION=3.1.7
ACMESH_COMMIT=5567d7fe7298fd37aca53194885ba444c6678669
