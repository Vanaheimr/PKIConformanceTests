<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Hermod's ACME client (RFC 8555) against a server of the suite's own - written from the RFC, strict where it is, and scripted test by test: every request it sends is read by RawACME, every answer it gets is the test's.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PKIConformance.Core\PKIConformance.Core.csproj" />
  </ItemGroup>

</Project>
